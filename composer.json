{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/nwidart-laravel-menus",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/laravel-paystack",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/knox-pesapal",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "aloha/twilio": "^4.0",
        "automattic/woocommerce": "^3.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "composer/semver": "^3.0",
        "consoletvs/charts": "^6.8",
        "giggsey/libphonenumber-for-php": "^8.12",
        "guzzlehttp/guzzle": "^7.8",
        "konekt/html": "^6.8",
        "knox/pesapal": "2.2.1",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^4.0",
        "milon/barcode": "^13.0",
        "mpdf/mpdf": "^8.2",
        "myfatoorah/laravel-package": "^2.2",
        "nwidart/laravel-menus": "@dev",
        "nwidart/laravel-modules": "^13.0",
        "openai-php/laravel": "^0.19.1",
        "opcodesio/log-viewer": "^3.0",
        "propaganistas/laravel-disposable-email": "^2.4",
        "pusher/pusher-php-server": "^7.2",
        "razorpay/razorpay": "^2.9",
        "spatie/flysystem-dropbox": "^3.0",
        "spatie/laravel-activitylog": "^4.9",
        "spatie/laravel-backup": "^10.0",
        "spatie/laravel-permission": "^6.0",
        "srmklive/paypal": "^3.0",
        "stripe/stripe-php": "^16.0",
        "unicodeveloper/laravel-paystack": "1.2.1",
        "yajra/laravel-datatables-oracle": "^13.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "fakerphp/faker": "^1.23",
        "knuckleswtf/scribe": "^5.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "files": [
            "app/Http/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
