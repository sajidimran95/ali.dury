{
  "info": {
    "_postman_id": "3c730db9-d066-474e-9387-3b1ed461eff6",
    "name": "JAPS POS - Customer App API v1",
    "description": "Native Customer app. Same rules as the /customer PWA. Run **0. Setup & Auth > Login** first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://japspos.test",
      "type": "string",
      "description": "Server root chosen by the user in the app (no trailing slash, no /api)."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Set automatically by the Login request."
    },
    {
      "key": "login",
      "value": "012548963145",
      "type": "string"
    },
    {
      "key": "password",
      "value": "12345678",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "5541",
      "type": "string"
    },
    {
      "key": "variation_id",
      "value": "5541",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup & Auth",
      "description": "",
      "item": [
        {
          "name": "Ping (check base URL)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ping",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "ping"
              ]
            },
            "description": "Public. Call when the user enters / changes the server URL. A valid JAPS POS server answers `success: true` and `data.api = \"japspos-mobile\"`.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "login"
              ]
            },
            "description": "login = email or mobile (any format, digits are matched). Contact must have Customer App access enabled.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved to collection variable {{token}}');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me (profile + business)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "me"
              ]
            },
            "description": "Current account, permissions and business settings."
          },
          "response": []
        },
        {
          "name": "Logout (this device)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the token used for this request."
          },
          "response": []
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/customer/auth/logout-all",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "customer",
                "auth",
                "logout-all"
              ]
            },
            "description": "Revokes every token of this account for this app."
          },
          "response": []
        }
      ]
    },
